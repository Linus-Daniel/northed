# ---------------------------------------------------------------------------
# NorthEd — local app configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL into
# `.env.local` for you the first time you run it. Never commit real values.

# Deployment name (printed by `npx convex dev`, e.g. "dev-abc123")
CONVEX_DEPLOYMENT=

# Public URL of the Convex deployment, used by the browser client
# (e.g. "https://dev-abc123-1234.convex.cloud")
NEXT_PUBLIC_CONVEX_URL=

# The deployment's site URL. Convex Auth uses it as the trusted auth domain.
# Convex sets this automatically in `.env.local` as CONVEX_SITE_URL.
CONVEX_SITE_URL=

# Public URL of this Next.js app. Used for absolute links / redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Convex Auth keys — these belong to the DEPLOYMENT, not to this file.
# ---------------------------------------------------------------------------
# Convex Auth signs session tokens with an RS256 key pair. The private key
# (JWT_PRIVATE_KEY) and the public key set (JWKS) live in the deployment's
# environment and are set with:
#
#     npm run auth:keys          # the dev deployment
#     npm run auth:keys:prod     # the production deployment
#
# Do not put them in `.env.local` and do not commit them anywhere.
